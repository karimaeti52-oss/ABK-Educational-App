rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global zero-trust safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true &&
             'email' in request.auth.token &&
             request.auth.token.email == 'karimaeti07@gmail.com';
    }

    function adminDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDocData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdminDocActive() {
      return adminDocExists() && (!('active' in adminDocData()) || adminDocData().active == true);
    }

    function effectiveRole() {
      return isBootstrappedAdmin()
        ? 'SUPER_ADMIN'
        : (
            isSignedIn() &&
            'abkRole' in request.auth.token &&
            request.auth.token.abkRole in ['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'TEACHER', 'VIEWER']
          )
          ? request.auth.token.abkRole
          : (
              isAdminDocActive()
              ? (
                  ('role' in adminDocData() && adminDocData().role in ['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'TEACHER', 'VIEWER'])
                    ? adminDocData().role
                    : 'ADMIN'
                )
              : 'STUDENT'
            );
    }

    function isSuperAdmin() {
      return effectiveRole() == 'SUPER_ADMIN';
    }

    // Standard full Admin or Super Admin (preserves backwards compatibility with existing tests/admin actions)
    function isAdmin() {
      return effectiveRole() in ['SUPER_ADMIN', 'ADMIN'];
    }

    // Content managers, admins, and super admins
    function isContentStaff() {
      return effectiveRole() in ['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER'];
    }

    function isTeacherStaff() {
      return effectiveRole() == 'TEACHER';
    }

    // Any authenticated staff user who can view admin portal data
    function isAnyStaffReader() {
      return effectiveRole() in ['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'TEACHER', 'VIEWER'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAccountActive() {
      return isSignedIn() && (
        isAnyStaffReader() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['SUSPENDED', 'BANNED'])
      );
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function isOptionalStringList(data, key, maxItems) {
      return !(key in data) || (data[key] is list && data[key].size() <= maxItems);
    }

    function isValidStatusFields(data) {
      return data.published is bool &&
             (!('status' in data) || data.status in ['DRAFT', 'PUBLISHED', 'ARCHIVED']) &&
             (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is timestamp && data.deletedAt <= request.time)) &&
             // If soft-deleted or archived/draft, published cannot be true
             ((!('deletedAt' in data) || data.deletedAt == null) || data.published == false) &&
             ((!('status' in data) || data.status == 'PUBLISHED') || data.published == false);
    }

    function isStudentVisible(data) {
      return data.published == true &&
             (!('status' in data) || data.status == 'PUBLISHED') &&
             (!('deletedAt' in data) || data.deletedAt == null);
    }

    // --- ENTITY VALIDATION HELPERS ---

    function isValidAdminEntry(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'permissions', 'teacherId', 'active', 'grantedBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             isOptionalString(data, 'displayName', 100) &&
             (!('role' in data) || data.role in ['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'TEACHER', 'VIEWER']) &&
             isOptionalStringList(data, 'permissions', 30) &&
             isOptionalString(data, 'teacherId', 128) &&
             isOptionalBool(data, 'active') &&
             data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 160 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'role', 'accountStatus', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'role', 'accountStatus', 'banReason', 'bannedAt', 'bannedBy', 'lastActiveAt', 'createdAt', 'updatedAt']) &&
             isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 160 &&
             isOptionalString(data, 'photoUrl', 500) &&
             data.role in ['STUDENT', 'ADMIN', 'SUPER_ADMIN', 'CONTENT_MANAGER', 'TEACHER', 'VIEWER'] &&
             data.accountStatus in ['ACTIVE', 'SUSPENDED', 'BANNED'] &&
             isOptionalString(data, 'banReason', 300) &&
             (!('bannedAt' in data) || data.bannedAt == null || (data.bannedAt is timestamp && data.bannedAt <= request.time)) &&
             isOptionalString(data, 'bannedBy', 160) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is timestamp && data.lastActiveAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCatalogNode(data) {
      return data.keys().hasAll(['nodeType', 'typeLabel', 'title', 'sortOrder', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['parentId', 'nodeType', 'typeLabel', 'title', 'subtitle', 'imageUrl', 'iconKey', 'accentColorHex', 'sortOrder', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             isOptionalString(data, 'parentId', 128) &&
             data.nodeType in ['STAGE', 'GRADE', 'BRANCH', 'COURSE', 'CUSTOM'] &&
             data.typeLabel is string && data.typeLabel.size() >= 1 && data.typeLabel.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             isOptionalString(data, 'subtitle', 300) &&
             isOptionalString(data, 'imageUrl', 1000) &&
             isOptionalString(data, 'iconKey', 50) &&
             isOptionalString(data, 'accentColorHex', 16) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 5000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['title', 'description', 'iconKey', 'sortOrder', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['title', 'description', 'imageUrl', 'iconKey', 'nodeIds', 'nodePathLabel', 'teacherIds', 'sortOrder', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 400 &&
             isOptionalString(data, 'imageUrl', 1000) &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             isOptionalStringList(data, 'nodeIds', 50) &&
             isOptionalString(data, 'nodePathLabel', 200) &&
             isOptionalStringList(data, 'teacherIds', 50) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUnit(data) {
      return data.keys().hasAll(['subjectId', 'subjectName', 'title', 'sortOrder', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['subjectId', 'subjectName', 'title', 'description', 'sortOrder', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             isOptionalString(data, 'description', 400) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['name', 'sortOrder', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'headline', 'bio', 'photoUrl', 'linkedUid', 'subjectIds', 'nodeIds', 'youtubeUrl', 'telegramUrl', 'websiteUrl', 'sortOrder', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             isOptionalString(data, 'headline', 140) &&
             isOptionalString(data, 'bio', 1000) &&
             isOptionalString(data, 'photoUrl', 1000) &&
             isOptionalString(data, 'linkedUid', 128) &&
             isOptionalStringList(data, 'subjectIds', 50) &&
             isOptionalStringList(data, 'nodeIds', 50) &&
             isOptionalString(data, 'youtubeUrl', 500) &&
             isOptionalString(data, 'telegramUrl', 500) &&
             isOptionalString(data, 'websiteUrl', 500) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 5000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLesson(data) {
      return data.keys().hasAll(['subjectId', 'subjectName', 'unitTitle', 'unitOrder', 'lessonOrder', 'title', 'description', 'videoUrl', 'videoSourceType', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['subjectId', 'subjectName', 'unitId', 'unitTitle', 'unitOrder', 'lessonOrder', 'title', 'description', 'teacherName', 'durationLabel', 'thumbnailUrl', 'videoUrl', 'videoSourceType', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 80 &&
             isOptionalString(data, 'unitId', 128) &&
             data.unitTitle is string && data.unitTitle.size() >= 1 && data.unitTitle.size() <= 100 &&
             data.unitOrder is int && data.unitOrder >= 0 && data.unitOrder <= 500 &&
             data.lessonOrder is int && data.lessonOrder >= 0 && data.lessonOrder <= 500 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.description is string && data.description.size() <= 1000 &&
             isOptionalString(data, 'teacherName', 100) &&
             isOptionalString(data, 'durationLabel', 30) &&
             isOptionalString(data, 'thumbnailUrl', 1000) &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             data.videoSourceType in ['YOUTUBE', 'MP4', 'EXTERNAL'] &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLessonExplanation(data) {
      return data.keys().hasAll(['lessonId', 'subjectId', 'teacherId', 'teacherName', 'title', 'sortOrder', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['lessonId', 'lessonTitle', 'subjectId', 'subjectName', 'teacherId', 'teacherName', 'teacherPhotoUrl', 'teacherUid', 'title', 'summary', 'sortOrder', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.lessonId) &&
             isOptionalString(data, 'lessonTitle', 140) &&
             isValidId(data.subjectId) &&
             isOptionalString(data, 'subjectName', 80) &&
             isValidId(data.teacherId) &&
             data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 120 &&
             isOptionalString(data, 'teacherPhotoUrl', 1000) &&
             isOptionalString(data, 'teacherUid', 128) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             isOptionalString(data, 'summary', 1000) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidContentBlock(data) {
      return data.keys().hasAll(['explanationId', 'lessonId', 'subjectId', 'teacherId', 'blockType', 'title', 'sortOrder', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['explanationId', 'lessonId', 'subjectId', 'teacherId', 'teacherUid', 'blockType', 'customTypeKey', 'title', 'subtitle', 'bodyText', 'mediaUrl', 'thumbnailUrl', 'durationLabel', 'fileSizeLabel', 'qaItems', 'quizQuestions', 'sortOrder', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.explanationId) &&
             isValidId(data.lessonId) &&
             isValidId(data.subjectId) &&
             isValidId(data.teacherId) &&
             isOptionalString(data, 'teacherUid', 128) &&
             data.blockType in ['YOUTUBE_VIDEO', 'EXTERNAL_VIDEO', 'PDF_FILE', 'IMAGE', 'NOTE_SUMMARY', 'QA', 'QUIZ_MCQ', 'QUIZ_TRUE_FALSE', 'INTERACTIVE_EXAM', 'RICH_TEXT', 'EXTERNAL_LINK', 'DOWNLOAD_FILE', 'ASSIGNMENT', 'CUSTOM'] &&
             isOptionalString(data, 'customTypeKey', 60) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             isOptionalString(data, 'subtitle', 300) &&
             isOptionalString(data, 'bodyText', 10000) &&
             isOptionalString(data, 'mediaUrl', 1000) &&
             isOptionalString(data, 'thumbnailUrl', 1000) &&
             isOptionalString(data, 'durationLabel', 40) &&
             isOptionalString(data, 'fileSizeLabel', 40) &&
             (!('qaItems' in data) || (data.qaItems is list && data.qaItems.size() <= 100)) &&
             (!('quizQuestions' in data) || (data.quizQuestions is list && data.quizQuestions.size() <= 100)) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 5000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomSectionType(data) {
      return data.keys().hasAll(['key', 'labelAr', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['key', 'labelAr', 'description', 'iconKey', 'accentColorHex', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.key) &&
             data.labelAr is string && data.labelAr.size() >= 1 && data.labelAr.size() <= 80 &&
             isOptionalString(data, 'description', 300) &&
             isOptionalString(data, 'iconKey', 50) &&
             isOptionalString(data, 'accentColorHex', 16) &&
             data.published is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['platformName', 'homeHeadline', 'primaryColorHex', 'secondaryColorHex', 'updatedBy', 'updatedAt']) &&
             data.keys().hasOnly(['platformName', 'platformTagline', 'homeHeadline', 'welcomeTitle', 'welcomeSubtitle', 'logoUrl', 'heroBannerUrl', 'primaryColorHex', 'secondaryColorHex', 'accentColorHex', 'bottomNavItems', 'allowOfflinePdf', 'showAnnouncements', 'showContinueWatching', 'maintenanceMode', 'updatedBy', 'updatedAt']) &&
             data.platformName is string && data.platformName.size() >= 1 && data.platformName.size() <= 60 &&
             isOptionalString(data, 'platformTagline', 100) &&
             data.homeHeadline is string && data.homeHeadline.size() >= 1 && data.homeHeadline.size() <= 100 &&
             isOptionalString(data, 'welcomeTitle', 140) &&
             isOptionalString(data, 'welcomeSubtitle', 300) &&
             isOptionalString(data, 'logoUrl', 1000) &&
             isOptionalString(data, 'heroBannerUrl', 1000) &&
             data.primaryColorHex is string && data.primaryColorHex.matches('^#[0-9a-fA-F]{6}$') &&
             data.secondaryColorHex is string && data.secondaryColorHex.matches('^#[0-9a-fA-F]{6}$') &&
             (!('accentColorHex' in data) || data.accentColorHex == null || data.accentColorHex.matches('^#[0-9a-fA-F]{6}$')) &&
             (!('bottomNavItems' in data) || (data.bottomNavItems is list && data.bottomNavItems.size() <= 8)) &&
             isOptionalBool(data, 'allowOfflinePdf') &&
             isOptionalBool(data, 'showAnnouncements') &&
             isOptionalBool(data, 'showContinueWatching') &&
             isOptionalBool(data, 'maintenanceMode') &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['subjectId', 'subjectName', 'materialType', 'title', 'description', 'fileUrl', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['subjectId', 'subjectName', 'lessonId', 'lessonTitle', 'teacherId', 'teacherUid', 'materialType', 'title', 'description', 'coverUrl', 'fileUrl', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 80 &&
             isOptionalString(data, 'lessonId', 128) &&
             isOptionalString(data, 'lessonTitle', 140) &&
             isOptionalString(data, 'teacherId', 128) &&
             isOptionalString(data, 'teacherUid', 128) &&
             data.materialType in ['TEXTBOOK', 'STUDY_NOTE', 'SUMMARY', 'IMPORTANT_QUESTIONS', 'WORKSHEET', 'PRACTICE_EXAM', 'ASSIGNMENT'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.description is string && data.description.size() <= 1000 &&
             isOptionalString(data, 'coverUrl', 1000) &&
             data.fileUrl is string && data.fileUrl.size() >= 1 && data.fileUrl.size() <= 1000 &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'category', 'pinned', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['title', 'body', 'category', 'subjectId', 'pinned', 'published', 'status', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             data.category in ['NEW_LESSON', 'NEW_MATERIAL', 'GENERAL', 'URGENT'] &&
             isOptionalString(data, 'subjectId', 128) &&
             data.pinned is bool &&
             isValidStatusFields(data) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'entityType', 'createdAt']) &&
             data.keys().hasOnly(['actorUid', 'actorEmail', 'actorRole', 'action', 'entityType', 'entityId', 'summary', 'createdAt']) &&
             data.actorUid == request.auth.uid &&
             isOptionalString(data, 'actorEmail', 160) &&
             isOptionalString(data, 'actorRole', 40) &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
             data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 80 &&
             isOptionalString(data, 'entityId', 128) &&
             isOptionalString(data, 'summary', 500) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFavorite(data, userId) {
      return data.keys().hasAll(['userId', 'itemId', 'itemType', 'title', 'subtitle', 'subjectName', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'itemId', 'itemType', 'title', 'subtitle', 'subjectName', 'imageUrl', 'createdAt']) &&
             data.userId == userId &&
             isValidId(data.itemId) &&
             data.itemType in ['LESSON', 'MATERIAL'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.subtitle is string && data.subtitle.size() <= 140 &&
             data.subjectName is string && data.subjectName.size() <= 80 &&
             isOptionalString(data, 'imageUrl', 1000) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidProgress(data, userId) {
      return data.keys().hasAll(['userId', 'lessonId', 'lessonTitle', 'subjectId', 'subjectName', 'lastPositionMs', 'durationMs', 'completed', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'lessonId', 'lessonTitle', 'subjectId', 'subjectName', 'thumbnailUrl', 'lastPositionMs', 'durationMs', 'completed', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             isValidId(data.lessonId) &&
             data.lessonTitle is string && data.lessonTitle.size() >= 1 && data.lessonTitle.size() <= 140 &&
             isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() <= 80 &&
             isOptionalString(data, 'thumbnailUrl', 1000) &&
             data.lastPositionMs is int && data.lastPositionMs >= 0 &&
             data.durationMs is int && data.durationMs >= 0 &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReadAnnouncement(data, userId, announcementId) {
      return data.keys().hasAll(['userId', 'announcementId', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'announcementId', 'createdAt']) &&
             data.userId == userId &&
             data.announcementId == announcementId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAndroidRelease(data) {
      return data.keys().hasAll(['versionCode', 'versionName', 'apkUrl', 'sha256', 'mandatory', 'updatedBy', 'updatedAt']) &&
             data.keys().hasOnly(['versionCode', 'versionName', 'minSupportedVersionCode', 'apkUrl', 'sha256', 'fileSizeBytes', 'releaseNotes', 'mandatory', 'publishedAtMillis', 'updatedBy', 'updatedAt']) &&
             data.versionCode is int && data.versionCode >= 1 &&
             data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 40 &&
             (!('minSupportedVersionCode' in data) || (data.minSupportedVersionCode is int && data.minSupportedVersionCode >= 0)) &&
             data.apkUrl is string && data.apkUrl.matches('^https://.*') && data.apkUrl.size() <= 1000 &&
             data.sha256 is string && data.sha256.matches('^[a-fA-F0-9]{64}$') &&
             (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0)) &&
             isOptionalString(data, 'releaseNotes', 2000) &&
             data.mandatory is bool &&
             (!('publishedAtMillis' in data) || (data.publishedAtMillis is int && data.publishedAtMillis >= 0)) &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- COLLECTION RULES ---

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAnyStaffReader());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(adminUid) && isValidAdminEntry(incoming()) && incoming().uid == adminUid;
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       (
                         (isOwner(userId) && incoming().userId == userId && incoming().role == 'STUDENT' && incoming().accountStatus == 'ACTIVE') ||
                         (isAdmin() && incoming().userId == userId)
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           isOwner(userId) &&
                           existing().accountStatus == 'ACTIVE' &&
                           incoming().role == existing().role &&
                           incoming().accountStatus == existing().accountStatus &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'lastActiveAt', 'updatedAt'])
                         )
                       );

      allow delete: if isSuperAdmin() && isValidId(userId);

      match /favorites/{favoriteId} {
        allow get: if isOwner(userId) && isAccountActive() && isValidId(favoriteId);
        allow list: if isOwner(userId) && isAccountActive();
        allow create: if isOwner(userId) && isAccountActive() && isValidId(favoriteId) && isValidFavorite(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isAccountActive() && isValidId(favoriteId);
      }

      match /progress/{lessonId} {
        allow get: if isOwner(userId) && isAccountActive() && isValidId(lessonId);
        allow list: if isOwner(userId) && isAccountActive();
        allow create: if isOwner(userId) && isAccountActive() && isValidId(lessonId) && isValidProgress(incoming(), userId) && incoming().lessonId == lessonId;
        allow update: if isOwner(userId) &&
                         isAccountActive() &&
                         isValidId(lessonId) &&
                         isValidProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().lessonId == existing().lessonId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['lessonTitle', 'subjectId', 'subjectName', 'thumbnailUrl', 'lastPositionMs', 'durationMs', 'completed', 'updatedAt']);
        allow delete: if isOwner(userId) && isAccountActive() && isValidId(lessonId);
      }

      match /readAnnouncements/{announcementId} {
        allow get: if isOwner(userId) && isAccountActive() && isValidId(announcementId);
        allow list: if isOwner(userId) && isAccountActive();
        allow create: if isOwner(userId) && isAccountActive() && isValidId(announcementId) && isValidReadAnnouncement(incoming(), userId, announcementId);
        allow update: if false;
        allow delete: if isOwner(userId) && isAccountActive() && isValidId(announcementId);
      }
    }

    match /catalogNodes/{nodeId} {
      allow get: if isAccountActive() && isValidId(nodeId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(nodeId) && isValidCatalogNode(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isContentStaff() && isValidId(nodeId) && isValidCatalogNode(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(nodeId);
    }

    match /subjects/{subjectId} {
      allow get: if isAccountActive() && isValidId(subjectId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(subjectId) && isValidSubject(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isContentStaff() && isValidId(subjectId) && isValidSubject(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(subjectId);
    }

    match /units/{unitId} {
      allow get: if isAccountActive() && isValidId(unitId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(unitId) && isValidUnit(incoming()) && incoming().createdBy == request.auth.uid && exists(/databases/$(database)/documents/subjects/$(incoming().subjectId));
      allow update: if isContentStaff() && isValidId(unitId) && isValidUnit(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(unitId);
    }

    match /teachers/{teacherId} {
      allow get: if isAccountActive() && isValidId(teacherId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(teacherId) && isValidTeacher(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isContentStaff() && isValidId(teacherId) && isValidTeacher(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(teacherId);
    }

    match /lessons/{lessonId} {
      allow get: if isAccountActive() && isValidId(lessonId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(lessonId) && isValidLesson(incoming()) && incoming().createdBy == request.auth.uid && exists(/databases/$(database)/documents/subjects/$(incoming().subjectId));
      allow update: if isContentStaff() && isValidId(lessonId) && isValidLesson(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(lessonId);
    }

    match /lessonExplanations/{explanationId} {
      allow get: if isAccountActive() && isValidId(explanationId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isValidId(explanationId) &&
                       isValidLessonExplanation(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       exists(/databases/$(database)/documents/lessons/$(incoming().lessonId)) &&
                       exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
                       (
                         isContentStaff() ||
                         (isTeacherStaff() && ('teacherUid' in incoming()) && incoming().teacherUid == request.auth.uid && incoming().published == false)
                       );
      allow update: if isValidId(explanationId) &&
                       isValidLessonExplanation(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().createdBy == existing().createdBy &&
                       (
                         isContentStaff() ||
                         (isTeacherStaff() && ('teacherUid' in existing()) && existing().teacherUid == request.auth.uid && incoming().teacherUid == existing().teacherUid && incoming().published == existing().published)
                       );
      allow delete: if isAdmin() && isValidId(explanationId);
    }

    match /contentBlocks/{blockId} {
      allow get: if isAccountActive() && isValidId(blockId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isValidId(blockId) &&
                       isValidContentBlock(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       exists(/databases/$(database)/documents/lessonExplanations/$(incoming().explanationId)) &&
                       (
                         isContentStaff() ||
                         (isTeacherStaff() && ('teacherUid' in incoming()) && incoming().teacherUid == request.auth.uid && incoming().published == false)
                       );
      allow update: if isValidId(blockId) &&
                       isValidContentBlock(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().createdBy == existing().createdBy &&
                       (
                         isContentStaff() ||
                         (isTeacherStaff() && ('teacherUid' in existing()) && existing().teacherUid == request.auth.uid && incoming().teacherUid == existing().teacherUid && incoming().published == existing().published)
                       );
      allow delete: if (isAdmin() || (isTeacherStaff() && ('teacherUid' in existing()) && existing().teacherUid == request.auth.uid)) && isValidId(blockId);
    }

    match /customSectionTypes/{typeId} {
      allow get: if isAccountActive() && isValidId(typeId) && (existing().published == true || isAnyStaffReader());
      allow list: if isAccountActive() && (existing().published == true || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(typeId) && isValidCustomSectionType(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isContentStaff() && isValidId(typeId) && isValidCustomSectionType(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(typeId);
    }

    match /platformConfig/{configId} {
      allow get: if isAccountActive() && isValidId(configId) && (configId == 'main' || isAnyStaffReader());
      allow list: if isAnyStaffReader();
      allow create, update: if isAdmin() && configId == 'main' && isValidPlatformConfig(incoming());
      allow delete: if isSuperAdmin() && configId != 'main';
    }

    match /appConfig/{configId} {
      allow get: if isAccountActive() && configId == 'android_release';
      allow list: if isAnyStaffReader();
      allow create, update: if isAdmin() && configId == 'android_release' && isValidAndroidRelease(incoming());
      allow delete: if false;
    }

    match /materials/{materialId} {
      allow get: if isAccountActive() && isValidId(materialId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isValidId(materialId) &&
                       isValidMaterial(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       exists(/databases/$(database)/documents/subjects/$(incoming().subjectId)) &&
                       (
                         isContentStaff() ||
                         (isTeacherStaff() && ('teacherUid' in incoming()) && incoming().teacherUid == request.auth.uid && incoming().published == false)
                       );
      allow update: if isValidId(materialId) &&
                       isValidMaterial(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().createdBy == existing().createdBy &&
                       (
                         isContentStaff() ||
                         (isTeacherStaff() && ('teacherUid' in existing()) && existing().teacherUid == request.auth.uid && incoming().teacherUid == existing().teacherUid && incoming().published == existing().published)
                       );
      allow delete: if isAdmin() && isValidId(materialId);
    }

    match /announcements/{announcementId} {
      allow get: if isAccountActive() && isValidId(announcementId) && (isStudentVisible(existing()) || isAnyStaffReader());
      allow list: if isAccountActive() && (isStudentVisible(existing()) || isAnyStaffReader());
      allow create: if isContentStaff() && isValidId(announcementId) && isValidAnnouncement(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isContentStaff() && isValidId(announcementId) && isValidAnnouncement(incoming()) && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    match /auditLogs/{logId} {
      allow get, list: if isAnyStaffReader();
      allow create: if isAnyStaffReader() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    match /backups/{backupId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin() && isValidId(backupId);
    }
  }
}
